# Copy this file to .env and fill it in:
#
#   copy .env.example .env
#
# .env is ignored by git, so your real password never gets committed.
# This example is committed, so keep placeholders in it and nothing real.
#
# Leave .env out entirely and MediaFlow still runs: confirmation emails are
# printed in the terminal where the server is running instead of being sent.

# --- Sending real confirmation emails ---------------------------------------
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_HOST_USER="your.project.account@gmail.com"

# For Gmail this is an app password, not the account's normal password.
# Google Account > Security > 2-Step Verification > App passwords.
# It is 16 letters; Google shows it in groups of four, spaces are fine here.
EMAIL_HOST_PASSWORD="abcd efgh ijkl mnop"

DEFAULT_FROM_EMAIL="MediaFlow <your.project.account@gmail.com>"

# Optional. These are the defaults, which suit Gmail.
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
