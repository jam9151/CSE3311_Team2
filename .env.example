# Copy this file to .env and fill it in:
#
#   copy .env.example .env
#
# .env is ignored by git, so your real password never gets committed.
# This example is committed, so keep placeholders in it and nothing real.
#
# Leave .env out entirely and MediaFlow still runs: confirmation emails are
# printed in the terminal where the server is running instead of being sent.

# --- Sending real confirmation emails ---------------------------------------
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_HOST_USER="your.project.account@gmail.com"

# For Gmail this is an app password, not the account's normal password.
# Google Account > Security > 2-Step Verification > App passwords.
# It is 16 letters; Google shows it in groups of four, spaces are fine here.
EMAIL_HOST_PASSWORD="abcd efgh ijkl mnop"

DEFAULT_FROM_EMAIL="MediaFlow <your.project.account@gmail.com>"

# Optional. These are the defaults, which suit Gmail.
# EMAIL_PORT=587
# EMAIL_USE_TLS=true

# --- Growing the catalog (python manage.py import_catalog) -------------------
# Books come from Open Library and need no key. The rest need a free one:
#
#   TMDB (movies and TV): themoviedb.org > Settings > API. Either the
#   "API Key" or the long "API Read Access Token" works here.
#   RAWG (games): rawg.io/apidocs
#
# A source with no key is skipped, the others still run.
# TMDB_API_KEY="paste-your-tmdb-key-here"
# RAWG_API_KEY="paste-your-rawg-key-here"

# Optional. Open Library lets clients that say who they are make 3 calls a
# second instead of 1, which makes the book import about three times faster.
# Defaults to EMAIL_HOST_USER above if that is set.
# CATALOG_CONTACT_EMAIL="you@example.com"

# --- Deploying ---------------------------------------------------------------
# Leave all of these out for local work. With none set, debug is on and the app
# uses development values. Switching DJANGO_DEBUG to false makes the app strict:
# it won't start without a secret key and the allowed hosts. See "Deploying" in
# the README for what each one does.
#
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY="generate one, the README shows how"
# DJANGO_ALLOWED_HOSTS="mediaflow.example.com"
# DJANGO_CSRF_TRUSTED_ORIGINS="https://mediaflow.example.com"
# DJANGO_BEHIND_PROXY=true
# DJANGO_HSTS_SECONDS=0
# DATABASE_PATH="/data/db.sqlite3"

# --- Docker -------------------------------------------------------------------
# docker compose reads this same file. DJANGO_SECRET_KEY is required there. Use
# the generator in the README, because Django's own can make a key containing $
# or #, which Docker reads as variable and comment syntax.
#
# DJANGO_SECRET_KEY="generate one, the README shows how"
# HOST_PORT=8000
# GUNICORN_WORKERS=3
# A server you reach over plain http (no HTTPS yet), not just localhost:
# DJANGO_ALLOWED_HOSTS="megatron,192.168.1.50"   what you type in the browser
# DJANGO_SECURE_COOKIES=false                    until HTTPS is in front

# A real domain with HTTPS through the bundled Caddy (see "HTTPS on a real domain"
# in the README). Use these instead of DJANGO_SECURE_COOKIES=false:
# DJANGO_ALLOWED_HOSTS="mediaflow.jessemcnary.com"
# DJANGO_CSRF_TRUSTED_ORIGINS="https://mediaflow.jessemcnary.com"
# DJANGO_BEHIND_PROXY=true
# DJANGO_SSL_REDIRECT=true
# MEDIAFLOW_DOMAIN=mediaflow.jessemcnary.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
#
# With a reverse proxy of your own on the same machine, keep the app off the network:
# BIND_ADDRESS=127.0.0.1
#
# A reverse proxy already running in Docker on the server (a shared Caddy, say).
# Use these INSTEAD of the two Caddy lines above, and see "If a proxy already runs
# on the server" in the README:
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=the-name-of-your-proxys-docker-network
#
# Or a Cloudflare Tunnel, which needs no open ports and leaves any proxy on the
# server alone. Use these INSTEAD of the lines above, and see "Without touching
# the proxy: a Cloudflare Tunnel" in the README:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
# TUNNEL_TOKEN="the long token from the tunnel's page in Cloudflare"
